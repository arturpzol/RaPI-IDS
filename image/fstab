# Partition ids are fixed by the image build (disk identifier 0x52415049,
# "RAPI"), so they survive being written to any card or disk.
proc                  /proc           proc  defaults                 0  0
PARTUUID=52415049-01  /boot/firmware  vfat  defaults,noatime,nofail  0  2
PARTUUID=52415049-02  /               ext4  defaults,noatime         0  1
