#!/usr/bin/env bash
# Engine tuning that is not about the capture interface. Installed root-owned
# and run at setup time; the panel never calls it, so no sudoers entry.
#
#   rapi-tuning
#
# Two settings, both taken from a UniFi Dream Machine SE running the same
# engine on comparable hardware, and both kept only because they survived
# being measured:
#
#   stream.bypass   Stop reassembling a stream once reassembly.depth is
#                   reached instead of carrying it. The rest of a large
#                   download was never going to be inspected anyway, and
#                   holding it is what turned two eight-second bursts of bulk
#                   traffic into the only packet loss this sensor has had.
#
#   mpm-algo        `auto` resolves to `ac` here, the full Aho-Corasick tables.
#                   `ac-ks` is 53 MB smaller, measured on this rule set: 1081
#                   MB against 1028 MB peak. Named rather than left to `auto`
#                   so a different build cannot silently change it.
#
# What did not survive measuring, and is deliberately not here: detect.profile
# (1081 MB against 1085 MB - noise), the memory caps (SE runs 4 to 30 times
# leaner, but ours are caps and the engine uses 11 MB of a 128 MB flow cap), and
# mpm-algo: hs, which is what SE actually gains from and which the Debian arm64
# build does not have - `Hyperscan support: no`.
#
# The stream key is written whole. An include replaces a whole top-level key,
# so a file containing only `bypass` silently takes reassembly.depth with it,
# and the engine says what happens next:
#
#   i: stream-tcp: stream.reassembly.depth set to unlimited by default
#
# The values are read back out of the running engine rather than written here,
# for the same reason as the variables in rapi-capture-apply: whatever the
# package ships is carried over instead of transcribed and left to drift.
set -euo pipefail

YAML="${RAPI_SURICATA_YAML:-/etc/suricata/suricata.yaml}"
OUT="${RAPI_SURICATA_TUNING:-/etc/suricata/rapi-tuning.yaml}"
INCLUDE_HELPER="${RAPI_INCLUDE_BIN:-/usr/local/sbin/rapi-include}"
MPM_ALGO="${RAPI_MPM_ALGO:-ac-ks}"

die() { echo "$1" >&2; exit 1; }

[[ -f "$YAML" ]] || die "cannot find $YAML"

CURRENT="$(suricata --dump-config -c "$YAML" 2>/dev/null || true)"
grep -q '^stream\.' <<<"$CURRENT" || die "could not read the stream settings from $YAML"
if grep -E '^stream\..* = .*"' <<<"$CURRENT" >/dev/null; then
  die "a stream setting contains a quote - refusing to rewrite them"
fi

# Flat "a.b.c = value" lines back into nested YAML. The dump is in document
# order and a container prints as "(null)", so a level opens the first time a
# path component differs from the one on the line before.
render() {
  awk '
    {
      sep = index($0, " = ")
      if (sep == 0) next
      path = substr($0, 1, sep - 1)
      value = substr($0, sep + 3)
      if (value == "(null)") next
      n = split(path, part, ".")
      for (i = 1; i < n; i++) {
        if (i > prevn || part[i] != prev[i]) {
          indent = ""
          for (j = 1; j < i; j++) indent = indent "  "
          print indent part[i] ":"
          for (j = i + 1; j <= prevn; j++) prev[j] = ""
        }
      }
      indent = ""
      for (j = 1; j < n; j++) indent = indent "  "
      printf "%s%s: \"%s\"\n", indent, part[n], value
      for (i = 1; i <= n; i++) prev[i] = part[i]
      prevn = n
    }
  '
}

STREAM="$(grep -E '^stream\.' <<<"$CURRENT" | render)"
[[ "$(head -1 <<<"$STREAM")" == "stream:" ]] \
  || die "the rendered stream key does not start with stream: - not writing it"

# bypass is added rather than substituted: it is absent from the packaged file,
# so it is absent from --dump-config, and there is nothing to replace. It is a
# direct child of stream, so the place for it is the line after the header.
if ! grep -q '^  bypass:' <<<"$STREAM"; then
  STREAM="$(printf 'stream:\n  bypass: "yes"\n%s\n' "$(tail -n +2 <<<"$STREAM")")"
fi

{
  echo '%YAML 1.1'
  echo '---'
  echo "# Generated by RaPi IDS Panel ($(date -Is)) - do not edit by hand."
  echo '# Whole keys, because an include replaces a whole key.'
  echo ''
  echo "mpm-algo: $MPM_ALGO"
  echo ''
  printf '%s\n' "$STREAM"
} > "${OUT}.new"
mv "${OUT}.new" "$OUT"
chmod 0644 "$OUT"

"$INCLUDE_HELPER"

if ! OUTPUT="$(suricata -T -c "$YAML" 2>&1)"; then
  rm -f "$OUT"
  "$INCLUDE_HELPER" || true
  echo "$OUTPUT" >&2
  die "the engine rejected this configuration - the tuning file was removed"
fi

# The failure this whole file exists to avoid, checked rather than assumed.
if grep -q 'depth set to unlimited' <<<"$OUTPUT"; then
  rm -f "$OUT"
  "$INCLUDE_HELPER" || true
  die "writing the stream key dropped reassembly.depth - the tuning file was removed"
fi

echo "ok tuning=$OUT (mpm-algo=$MPM_ALGO, stream.bypass=yes)"
