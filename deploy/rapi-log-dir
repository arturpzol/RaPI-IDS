#!/usr/bin/env bash
# Prepare the directory the panel points the engine at: create it if it is not
# there, then set up log rotation for it.
# Installed as /usr/local/sbin/rapi-log-dir (root:root, 0755).
#
# It creates the directory because the panel cannot. A disk mounted at /mnt/ssd
# belongs to root, so an unprivileged `mkdir` inside it fails, and the panel used
# to answer that by printing `sudo mkdir -p ... && sudo chown ...` for the
# operator to paste into a shell. On a device whose whole promise is that there
# is no shell, that was the bug: a button that could only ever tell you to go
# somewhere else.
#
# Why a separate script instead of writing the file from the panel:
# logrotate ignores configuration files not owned by root ("Ignoring X because
# the file owner is wrong"), so the trick used for rapi-overrides.yaml - handing
# the file to the panel user - does not work here. Instead, sudo lets the panel
# run THIS script with one argument, and the config content is produced here,
# on the root side.
#
# That matters for security: a logrotate config may carry postrotate/prerotate
# sections executed as root. If the panel wrote the file itself, anyone reaching
# the panel over HTTP would have root. Here the panel can only name a directory,
# and only one that passes the validation below.
set -euo pipefail

TARGET="${1:-}"
CONF="/etc/logrotate.d/rapi-suricata"

if [[ -z "$TARGET" ]]; then
  echo "usage: $(basename "$0") <log-directory>" >&2
  exit 2
fi

# Plain characters only. This rejects newlines and quotes - the raw material for
# injecting an extra section into the configuration file.
if [[ ! "$TARGET" =~ ^/[A-Za-z0-9._/-]+$ ]]; then
  echo "illegal characters in path: $TARGET" >&2
  exit 3
fi
if [[ "$TARGET" == *".."* ]]; then
  echo "path must not contain '..': $TARGET" >&2
  exit 3
fi

# The same directories the panel rejects (backend/app/modules/suricata/logdir.py).
for bad in /home /root /etc /usr /bin /sbin /lib /lib64 /boot /proc /sys /dev /run /var/lib /snap; do
  if [[ "$TARGET" == "$bad" || "$TARGET" == "$bad/"* ]]; then
    echo "$bad is not a place for logs" >&2
    exit 4
  fi
done

# Created root:root 0755, which is what the engine needs and no more. Suricata
# runs as root and writes the files; the panel only ever reads them, and 0755
# lets it. Handing the directory to the panel user would give an HTTP-reachable
# process write access to a disk it has no reason to write to.
if [[ ! -d "$TARGET" ]]; then
  if [[ -e "$TARGET" ]]; then
    echo "exists and is not a directory: $TARGET" >&2
    exit 5
  fi
  # The parent has to be a real mount or directory already. Creating a deep tree
  # under nothing would silently make a log directory on the boot card at a path
  # that looks like a disk.
  parent="$(dirname "$TARGET")"
  if [[ ! -d "$parent" ]]; then
    echo "no such directory: $parent" >&2
    exit 5
  fi
  # A mount point whose volume is not mounted is still a directory, and an empty
  # one on the boot card. Creating the log directory inside it succeeds, the
  # engine writes there happily, and the card fills up instead of the disk. The
  # test that separates that from a deliberate "no disk here, use the card" is
  # fstab: if the parent is listed there and is not currently a mount point, the
  # volume that belongs there failed to come up and this is the wrong moment to
  # start writing logs.
  fstab_target="$(findmnt --fstab --noheadings --output TARGET --target "$parent" 2>/dev/null || true)"
  if [[ "$fstab_target" == "$parent" ]] && ! mountpoint -q "$parent"; then
    echo "$parent is a mount point in /etc/fstab but nothing is mounted there - refusing to write logs to the boot card" >&2
    exit 8
  fi
  if ! install -d -m 0755 -o root -g root "$TARGET" 2>/dev/null; then
    # Its own code and its own sentence: falling through to `set -e` here gave
    # a bare exit 1, which tells the panel nothing it can put on screen.
    echo "cannot create $TARGET (is the volume read-only, or full?)" >&2
    exit 7
  fi
  echo "created $TARGET"
fi

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

cat > "$TMP" <<EOF
# Generated by RaPi IDS Panel (rapi-logrotate-dir).
# Do not edit by hand - it is overwritten on the next log directory change.
#
# The packaged /etc/logrotate.d/suricata covers only /var/log/suricata; this
# file adds the directory selected in the panel.

$TARGET/*.log
$TARGET/*.json
{
	daily
	rotate 7
	missingok
	notifempty
	compress
	delaycompress
	# copytruncate: the engine keeps the files open, so we copy and truncate in
	# place instead of moving the inode. The panel reader detects truncation.
	copytruncate
	sharedscripts
}
EOF

# Syntax check on the copy - only a file logrotate can parse reaches
# /etc/logrotate.d.
if ! logrotate --debug "$TMP" >/dev/null 2>&1; then
  echo "generated configuration fails the logrotate test" >&2
  exit 6
fi

install -m 0644 -o root -g root "$TMP" "$CONF"
echo "rotation configured for $TARGET ($CONF)"
