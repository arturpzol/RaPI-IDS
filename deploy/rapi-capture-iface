#!/usr/bin/env bash
# Prepare an interface for passive capture, or hand it back to the network
# manager. Installed root-owned and called by the panel over sudo.
#
#   rapi-capture-iface <interface> capture|restore|boot
#
# A mirror destination port carries no conversation the machine is part of, so
# the interface must not ask for an address, and the offload engines that merge
# segments have to be off: rules that measure sizes or offsets otherwise match
# against frames the network never carried.
#
# None of that survives a reboot on its own, and the two halves fail together.
# Taking the interface out of NetworkManager's hands is what stops it flapping,
# but it also means nothing brings it up any more; `ethtool -K` lives in the
# driver and not on disk. So a rebooted sensor comes back with its capture
# interface down and its offloads back on, while the engine still reports
# itself as running and its counters simply stop moving. `capture` therefore
# also installs a unit that replays the runtime half at every boot, and `boot`
# is the mode that unit calls.
set -euo pipefail

SYS_NET="${RAPI_SYS_NET:-/sys/class/net}"
CONF_DIR="${RAPI_NM_CONF_DIR:-/etc/NetworkManager/conf.d}"
UNIT_DIR="${RAPI_SYSTEMD_DIR:-/etc/systemd/system}"
UNIT_TEMPLATE="rapi-capture-link@.service"
# Absolute, because it ends up in a unit file: systemd has no PATH worth relying
# on and this script is what the unit exists to run.
SELF="${RAPI_CAPTURE_IFACE_BIN:-/usr/local/sbin/rapi-capture-iface}"

die() { echo "$1" >&2; exit 1; }

[[ $# -eq 2 ]] || die "usage: $0 <interface> capture|restore|boot"
IFACE="$1"
MODE="$2"

[[ "$IFACE" =~ ^[A-Za-z0-9._-]{1,15}$ ]] || die "not an interface name: $IFACE"
[[ -e "$SYS_NET/$IFACE" ]] || die "no such interface: $IFACE"

CONF="$CONF_DIR/99-rapi-capture-$IFACE.conf"
UNIT_INSTANCE="rapi-capture-link@$IFACE.service"

# The card behind the name, when the kernel offers one. Empty for anything
# without a hardware address, and empty rather than wrong for the all-zero
# placeholder some virtual devices carry.
mac_of() {
  local mac
  mac="$(cat "$SYS_NET/$1/address" 2>/dev/null || true)"
  if [[ "$mac" =~ ^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$ && "$mac" != "00:00:00:00:00:00" ]]; then
    printf '%s' "${mac,,}"
  fi
}

# Offloads that hand merged or reassembled segments to userspace. Not every
# driver has every one of them, so each is tried on its own and a refusal is
# not an error: the Pi's onboard controller supports fewer than a server card.
OFFLOADS=(gro lro tso gso rx-gro-hw rxvlan)

# Everything that lives in the kernel rather than on disk, and therefore has to
# be done again after every boot.
prepare_link() {
  ip link set "$IFACE" up
  ip addr flush dev "$IFACE" || true
  # Suricata asks for promiscuous mode itself when it opens the socket, but
  # setting it here means the interface is already correct if someone looks
  # before the engine has restarted.
  ip link set "$IFACE" promisc on

  for feature in "${OFFLOADS[@]}"; do
    ethtool -K "$IFACE" "$feature" off >/dev/null 2>&1 || true
  done
}

case "$MODE" in
  capture)
    # Without this NetworkManager keeps trying DHCP on an interface that will
    # never answer, and puts the address back after every carrier event.
    mkdir -p "$CONF_DIR"
    # Matched on the card rather than on the name it happens to have today.
    # Raspberry Pi OS masks systemd's naming policies - both files under
    # /etc/systemd/network are symlinks to /dev/null - so a USB adapter is eth1
    # or eth2 depending on the order the ports were probed in. Pinned to the
    # name, this file stops matching the mirror port after a reseat, and
    # NetworkManager starts asking for an address on a port that answers
    # nothing. The onboard controller is a platform device and never moves, so
    # this only ever mattered for the adapter, which is the one people move.
    MAC="$(mac_of "$IFACE")"
    if [[ -n "$MAC" ]]; then
      MATCH="mac:$MAC"
    else
      MATCH="interface-name:$IFACE"
    fi
    cat > "$CONF" <<EOF
# Generated by RaPi IDS Panel - $IFACE is a capture interface.
# To hand the interface back to NetworkManager:
#   sudo rapi-capture-iface $IFACE restore
# The panel has no button for this; it only ever sets an interface up.
[device-rapi-capture-$IFACE]
match-device=$MATCH
managed=0
EOF
    chmod 0644 "$CONF"
    systemctl reload NetworkManager 2>/dev/null || true

    prepare_link

    # A template rather than one unit per interface: the inline bridge layout
    # prepares two, and a second file would be the same text twice. Bound to the
    # device unit so a USB adapter plugged in an hour after boot gets the same
    # treatment as one that was there at power-on, and ordered before the engine
    # so a sensor that starts at boot starts with a live interface.
    mkdir -p "$UNIT_DIR"
    cat > "$UNIT_DIR/$UNIT_TEMPLATE" <<EOF
[Unit]
Description=Prepare %i for passive capture (RaPi IDS Panel)
After=sys-subsystem-net-devices-%i.device
BindsTo=sys-subsystem-net-devices-%i.device
Before=suricata.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=$SELF %i boot

[Install]
WantedBy=sys-subsystem-net-devices-%i.device
WantedBy=multi-user.target
EOF
    chmod 0644 "$UNIT_DIR/$UNIT_TEMPLATE"
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable "$UNIT_INSTANCE" >/dev/null 2>&1 || true
    echo "ok $IFACE prepared for capture, $UNIT_INSTANCE enabled"
    ;;

  boot)
    # What the unit runs. The runtime half only: reloading NetworkManager or
    # enabling units from inside a unit systemd is in the middle of starting is
    # a way to deadlock a boot, and none of it would change anything anyway.
    #
    # First it checks that this really is still the capture interface, because
    # `prepare_link` flushes addresses. The unit instance is named after an
    # interface, and interface names get reused: unplug the adapter that was
    # eth1, plug a different one into the other port, and the enabled
    # `rapi-capture-link@eth1` now points at whatever took the name. Without
    # these two checks it would strip the address off a working management link
    # and put it in promiscuous mode, on a machine reachable only through it.
    [[ -f "$CONF" ]] || die "$IFACE is not a capture interface"
    WANTED="$(sed -n 's/^match-device=mac:\(.*\)$/\1/p' "$CONF" | head -1)"
    if [[ -n "$WANTED" && "${WANTED,,}" != "$(mac_of "$IFACE")" ]]; then
      die "$IFACE is not the card that was set up for capture"
    fi
    prepare_link
    echo "ok $IFACE prepared for capture"
    ;;

  restore)
    # The template stays: another interface may still be using it. Only this
    # instance stops being wanted.
    systemctl disable "$UNIT_INSTANCE" >/dev/null 2>&1 || true
    rm -f "$CONF"
    # A file written when this card had a different name still matches it by
    # MAC, and would go on holding it unmanaged after the panel believes it let
    # go - leaving a port with no address that nothing ever brings up. Removing
    # by name alone is what left it there.
    #
    # A loop, not `grep -l ... | while`. With the card's own file already gone,
    # which is the ordinary case, grep found nothing and returned non-zero;
    # pipefail carried that to the pipeline and set -e ended the script right
    # there, silently, before NetworkManager was reloaded and before the port
    # was handed back. So restore never finished for any card that had a MAC
    # and no second file. The tests covered a card with no MAC and a card with
    # a stale second file, and nothing in between. Found by booting the image:
    # the way back from blocking to detection could not build the bridge.
    MAC="$(mac_of "$IFACE")"
    if [[ -n "$MAC" ]]; then
      for stale in "$CONF_DIR"/99-rapi-capture-*.conf; do
        [[ -f "$stale" ]] || continue
        if grep -q "^match-device=mac:$MAC\$" "$stale"; then
          rm -f "$stale"
        fi
      done
    fi
    systemctl reload NetworkManager 2>/dev/null || true
    ip link set "$IFACE" promisc off || true
    for feature in "${OFFLOADS[@]}"; do
      ethtool -K "$IFACE" "$feature" on >/dev/null 2>&1 || true
    done
    # Bring the interface back under management so it asks for an address again.
    nmcli device set "$IFACE" managed yes >/dev/null 2>&1 || true
    echo "ok $IFACE handed back to NetworkManager"
    ;;

  *)
    die "unknown mode: $MODE"
    ;;
esac
