#!/usr/bin/env bash
# Decide what the engine writes to disk. Installed root-owned and run at setup
# time; the panel never calls it, so it needs no sudoers entry.
#
#   rapi-outputs
#
# The packaged configuration enables three outputs. Two of them cost a sensor
# that writes to an SD card real wear and give this panel nothing:
#
#   fast.log    every alert a second time, in a format nothing here reads.
#               The alerts are already in the panel's database.
#   stats.log   a full text dump of every counter every 8 seconds. Measured on
#               this device: 50 MB in 14 hours, against 107 MB of eve.json in
#               the same window. A third of everything the engine wrote, and
#               nobody has ever opened the file. The panel takes its counters
#               from the `stats` records inside eve.json, which stay.
#
# There is no way to switch off one entry of a list from an include: an include
# replaces a whole top-level key, and `outputs` is one key. So this writes the
# whole key, containing only eve-log - fast and stats stop existing by being
# left out. The other seven outputs the package ships are already `enabled: no`,
# so leaving them out changes nothing.
#
# The eve-log block is 297 lines and is copied out of the packaged file rather
# than written here. Transcribing it would mean owning 35 event types by hand
# and drifting from the package on the first update; copying means the block is
# faithful by construction and picks up package changes whenever this is re-run.
set -euo pipefail

YAML="${RAPI_SURICATA_YAML:-/etc/suricata/suricata.yaml}"
OUT="${RAPI_SURICATA_OUTPUTS:-/etc/suricata/rapi-outputs.yaml}"
INCLUDE_HELPER="${RAPI_INCLUDE_BIN:-/usr/local/sbin/rapi-include}"

die() { echo "$1" >&2; exit 1; }

[[ -f "$YAML" ]] || die "cannot find $YAML"

# Every top-level output entry sits at exactly two spaces; the event types
# inside eve-log are at eight. So a line at that one indentation opens a new
# entry, and the flag follows whichever entry that is.
BLOCK="$(awk '
  /^  - / { inblock = ($0 ~ /^  - eve-log:/) }
  inblock { print }
' "$YAML")"

[[ -n "$BLOCK" ]] || die "no eve-log block in $YAML - refusing to write an empty outputs key"
# A block without the alert type would be a sensor that logs everything except
# what it is for. Cheap to check, and the failure it prevents is silent.
grep -qE '^[[:space:]]+- alert:' <<<"$BLOCK" || die "the eve-log block has no alert type - not writing it"

{
  echo '%YAML 1.1'
  echo '---'
  echo '# Generated by RaPi IDS Panel - do not edit by hand.'
  echo '# The whole outputs key, because an include replaces a whole key. Only'
  echo '# eve-log is here: fast.log and stats.log are switched off by omission.'
  echo '# The eve-log block below is copied verbatim from the packaged file.'
  echo 'outputs:'
  printf '%s\n' "$BLOCK"
} > "${OUT}.new"
mv "${OUT}.new" "$OUT"
chmod 0644 "$OUT"

"$INCLUDE_HELPER"

if ! OUTPUT="$(suricata -T -c "$YAML" 2>&1)"; then
  rm -f "$OUT"
  echo "$OUTPUT" >&2
  die "the engine rejected this configuration - the outputs file was removed"
fi

echo "ok outputs=$OUT (fast.log and stats.log off)"
