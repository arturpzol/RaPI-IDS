#!/usr/bin/env bash
# The SSH password of the device account, kept equal to the panel's.
#
#   rapi-login-password status   prints "source=<card|key|panel|other|none>" and
#                                "login=<account>"
#   rapi-login-password set      reads one line, the new password, on stdin
#
# The image ships the account locked, so a card nobody prepared has no way in
# over SSH at all. The panel's own password is the one the operator has just
# chosen, and at least 12 characters, so it becomes the SSH password too.
#
# Whose password it is decides whether it may be changed, and that is recorded
# in a root-owned file under /var/lib (the panel cannot write there):
#
#   image  written by the image build, which locked the account itself. The
#          panel may claim it: status reports it as "none".
#   card   set when the card was prepared (userconf.txt or the flashing tool's
#          custom.toml, applied on the first boot). Never touched from here.
#   key    no password came with the card, a key did (authorized_keys). Whoever
#          prepared it chose keys, so no password is added from here: in
#          Debian that would switch password logins on for them.
#   panel  set from here before. Changed again when the panel password is.
#   (none) no file: a checkout on somebody's own Pi, where the account is
#          their login. Status reports it as "other". Never touched from here,
#          whatever state the account is in: a locked one is usually locked on
#          purpose, for keys only, and setting a password would open it.
#
# The password goes on stdin and never into argv, where `ps` would show it.
# chpasswd writes the shadow file, and in the panel's unit the whole of that
# directory is read-only: sudo does not leave the unit's mount namespace. So
# the write is handed to PID 1 with systemd-run, which runs it outside, rather
# than opening that directory to the panel.
set -euo pipefail

# The account the panel runs as, which is the one anybody would log in as.
# The image calls it rapi; a checkout runs the panel as whoever installed it,
# and naming rapi there would print a login that does not exist on that
# machine. The unit is the one place that already knows, and it is the same
# answer the panel itself runs under.
panel_user() {
  local name="" loaded=""
  name="$(systemctl show -p User --value rapi-panel.service 2>/dev/null)" || true
  [[ -z "$name" ]] || { printf '%s' "$name"; return; }
  # No User= at all: the unit runs as root, and saying "rapi" there would name
  # an account that may not exist on that machine. No unit at all: nothing is
  # installed yet, and the image's account is the only sensible answer.
  loaded="$(systemctl show -p LoadState --value rapi-panel.service 2>/dev/null)" || true
  if [[ "$loaded" == loaded ]]; then printf 'root'; else printf 'rapi'; fi
}

ACCOUNT="${RAPI_LOGIN_ACCOUNT:-$(panel_user)}"
STATE="${RAPI_LOGIN_STATE:-/var/lib/rapi-ssh-login}"

# "<image|card|key|panel> <account>", or no file.
recorded() {
  [[ -f "$STATE" ]] || return 1
  read -r REC_SOURCE REC_LOGIN < "$STATE" || true
  case "$REC_SOURCE" in image|card|key|panel) ;; *) return 1 ;; esac
  [[ -n "${REC_LOGIN:-}" ]] || REC_LOGIN="$ACCOUNT"
}

case "${1:-}" in
  status)
    if recorded; then
      [[ "$REC_SOURCE" == image ]] && REC_SOURCE=none
      echo "source=$REC_SOURCE"
      echo "login=$REC_LOGIN"
    else
      echo "source=other"
      echo "login=$ACCOUNT"
    fi
    ;;

  set)
    if ! recorded; then
      echo "$ACCOUNT is not the image's account; left alone" >&2
      exit 4
    fi
    if [[ "$REC_SOURCE" == card || "$REC_SOURCE" == key ]]; then
      echo "the way in was set when the card was prepared; left alone" >&2
      exit 3
    fi
    IFS= read -r password || true
    if (( ${#password} < 12 )); then
      echo "refusing a password shorter than 12 characters" >&2
      exit 2
    fi
    # The account named in the record, never the one the unit names now: the
    # record says which account the image (or an earlier set) claimed. A
    # checkout installed later as somebody else changes the unit, and taking
    # the account from there changed that person's own login, or root's.
    printf '%s:%s\n' "$REC_LOGIN" "$password" \
      | systemd-run --quiet --wait --pipe --collect chpasswd
    printf 'panel %s\n' "$REC_LOGIN" > "$STATE.tmp"
    chmod 0644 "$STATE.tmp"
    mv -f "$STATE.tmp" "$STATE"
    echo "source=panel"
    echo "login=$REC_LOGIN"
    ;;

  *)
    echo "usage: $0 status|set" >&2
    exit 64
    ;;
esac
