#!/usr/bin/env bash
# Put the engine in the path, or take it back out.
#
#   rapi-ips-mode status|ips|ids
#
# Installed root-owned and called by the panel over sudo.
#
# Being inline is not the same as blocking, and this is the difference. A kernel
# bridge forwards the frame and hands the engine a copy: the alert is raised
# after the packet has gone. What blocks is the engine deciding whether to hand
# the packet back, which is what NFQUEUE does - netfilter parks the packet,
# Suricata reads it, and the verdict decides whether it continues.
#
# NFQUEUE rather than af-packet copy-mode: ips, for now, because of what happens
# when the engine stops:
#
#   copy-mode: ips  the engine forwards. Engine down = link down. Fail closed.
#   NFQUEUE bypass  netfilter passes the packet when nothing is listening on
#                   the queue. Engine down = traffic flows, uninspected.
#
# `bypass` is on the rule below on purpose. A sensor that turns a network off
# when it crashes is a worse outcome than one that stops inspecting, for a
# device meant to be posted to somebody else's site and left alone. That is a
# decision, not a default, and it is the one this file is where it is written
# down.
#
# What this does NOT decide is whether anything actually drops. That is
# drop.conf: a rule loaded as `alert` reports and passes no matter which mode
# the engine is in.
set -euo pipefail

UNIT_DIR="${RAPI_SYSTEMD_DIR:-/etc/systemd/system}"
DROPIN_DIR="$UNIT_DIR/suricata.service.d"
DROPIN="$DROPIN_DIR/10-rapi-nfqueue.conf"
NFT_DIR="${RAPI_NFT_DIR:-/etc/nftables.d}"
NFT="$NFT_DIR/rapi-ips.nft"
NFT_TABLE="rapi_ips"
# The queue the engine reads and the rule writes. One number in one place.
QUEUE=0
# The ports that must never be queued: the panel on 443, its plain-HTTP
# redirect listeners on 80 and 8000, and ssh. Overridable so a checkout serving
# the panel somewhere else can say so; the sudoers entry takes no arguments, so
# this is not something a caller can widen.
ADMIN_PORTS="${RAPI_ADMIN_PORTS:-22, 80, 443, 8000}"

SURICATA="${RAPI_SURICATA_BIN:-/usr/bin/suricata}"
YAML="${RAPI_SURICATA_YAML:-/etc/suricata/suricata.yaml}"

die() { echo "$1" >&2; exit 1; }

nft_ruleset() {
  cat <<EOF
# Generated by RaPi IDS Panel - do not edit by hand.
# Everything except loopback and the administration ports goes past the engine
# and comes back with a verdict.
#
# The administration exemption is not a nicety. Switching to blocking used to
# queue the panel's own HTTPS session, and to a freshly started engine that
# session is a stream picked up midway: stream.midstream is false by default and
# exception-policy resolves to drop-flow in IPS mode, so the browser that clicked
# the switch was hung up on by the switch. On a device reached only over the
# network - which is every one of them - that is a sensor that can be turned on
# and not off, from a screen that has just stopped answering.
#
# Loopback alone did not cover it: the panel is reached over the network, not
# over lo. The old comment here claimed otherwise.
#
# What it costs: connections to and from these ports are not inspected. They are
# the management plane of the device doing the inspecting, and an appliance that
# blocks its own administration is not safer, only unreachable.
#
# Replaced, never added to. "nft -f" merges into a table that already exists
# and appends every rule again, so each call to this helper grew each chain by
# one more copy of its queue rule. The copies were dead rather than harmful:
# a queue statement ends the chain, so no packet ever reached the second one,
# measured in a network namespace. A ruleset that grows every time the switch
# is used is still not one anybody can read. The first line creates the table
# if it is missing, so the second can always delete it, and all three run as
# one transaction: there is no moment with no rules loaded.
#
# No backticks in this text: it is an unquoted heredoc, and bash runs them.
table inet $NFT_TABLE
delete table inet $NFT_TABLE
table inet $NFT_TABLE {
  chain forward {
    type filter hook forward priority filter; policy accept;
    queue num $QUEUE bypass
  }
  chain input {
    type filter hook input priority filter; policy accept;
    iifname "lo" accept
    tcp dport { $ADMIN_PORTS } accept
    queue num $QUEUE bypass
  }
  chain output {
    type filter hook output priority filter; policy accept;
    oifname "lo" accept
    tcp sport { $ADMIN_PORTS } accept
    queue num $QUEUE bypass
  }
}
EOF
}

# The packaged unit hardcodes --af-packet, so the mode is a drop-in that empties
# ExecStart and writes it again. Emptying it first is required: without the bare
# "ExecStart=" systemd appends rather than replaces, and the engine would be
# started twice with two different capture methods.
dropin() {
  cat <<EOF
# Generated by RaPi IDS Panel - do not edit by hand.
# Remove this file (or use the panel) to go back to detection only.
[Service]
ExecStart=
ExecStart=$SURICATA -D -q $QUEUE -c $YAML --pidfile /run/suricata/suricata.pid
EOF
}

case "${1:-}" in
  status)
    if [[ -f "$DROPIN" ]]; then
      echo "ips queue=$QUEUE"
    else
      echo "ids"
    fi
    ;;

  ips)
    command -v nft >/dev/null || die "nft is missing (apt install nftables)"
    mkdir -p "$DROPIN_DIR" "$NFT_DIR"
    nft_ruleset > "$NFT"
    chmod 0644 "$NFT"
    # Loaded now and at every boot. The file alone does nothing: nftables.service
    # reads /etc/nftables.conf, which does not include this directory on every
    # distribution, so the rules are applied here and the unit below is what
    # replays them.
    nft -f "$NFT" || die "the ruleset was refused - nothing has been changed"

    dropin > "$DROPIN"
    chmod 0644 "$DROPIN"
    systemctl daemon-reload
    # Restart, not reload: the capture method is chosen when the process starts.
    if ! systemctl restart suricata; then
      # Leaving the queue rule in place with nothing reading it would be safe
      # (bypass) but dishonest: the panel would report blocking that is not
      # happening. Back out completely instead.
      nft delete table inet "$NFT_TABLE" 2>/dev/null || true
      rm -f "$NFT" "$DROPIN"
      systemctl daemon-reload
      systemctl restart suricata || true
      die "the engine would not start in queue mode - put back as it was"
    fi
    echo "ok engine reading netfilter queue $QUEUE, rules with a drop action now drop"
    ;;

  ids)
    rm -f "$DROPIN"
    systemctl daemon-reload
    nft delete table inet "$NFT_TABLE" 2>/dev/null || true
    rm -f "$NFT"
    systemctl restart suricata || die "the engine would not restart"
    echo "ok engine back to reading a copy, nothing can be dropped"
    ;;

  clear)
    # The queue taken out of the way without touching the engine. Not reachable
    # from the panel: sudoers grants this helper three exact words and this is
    # not one of them. rapi-inline calls it directly, as root, in the middle of
    # a swap where it stops and starts the engine itself. Restarting here would
    # start the engine on a configuration already rewritten for the target
    # while the forwarding path is still the old one, which is two forwarders
    # at once. This file stays the only owner of the drop-in and the table.
    rm -f "$DROPIN"
    systemctl daemon-reload
    nft delete table inet "$NFT_TABLE" 2>/dev/null || true
    rm -f "$NFT"
    echo "ok queue cleared, engine not restarted"
    ;;

  *)
    die "usage: $0 status|ips|ids|clear"
    ;;
esac
